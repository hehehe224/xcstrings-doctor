{
  "name": "xcstrings-doctor",
  "version": "0.1.0",
  "description": "Audit Xcode String Catalogs for missing locales, placeholder drift, variations, and stale entries.",
  "type": "module",
  "bin": { "xcstrings-doctor": "./bin/xcstrings-doctor.js" },
  "exports": "./src/audit.js",
  "files": ["assets", "bin", "src", "LICENSE", "README.md", "SECURITY.md", "TRADEMARKS.md"],
  "scripts": {
    "test": "node --test",
    "check": "node --check bin/xcstrings-doctor.js && node --check src/audit.js",
    "prepack": "npm run check && npm test"
  },
  "engines": { "node": ">=20" },
  "keywords": ["xcstrings", "xcode", "localization", "ios", "swift", "linter", "i18n"],
  "author": "Lena",
  "license": "AGPL-3.0-only",
  "repository": { "type": "git", "url": "git+https://github.com/hehehe224/xcstrings-doctor.git" },
  "bugs": { "url": "https://github.com/hehehe224/xcstrings-doctor/issues" },
  "homepage": "https://github.com/hehehe224/xcstrings-doctor#readme"
}
